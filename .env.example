# URL pubblico (canonical, Open Graph, JSON-LD). Facoltativa: se vuota si usa l'URL Vercel del deploy.
NEXT_PUBLIC_SITE_URL=

# Neon Postgres (free tier) — se assente, i form rispondono 503 "servizio in attivazione".
DATABASE_URL=

# Resend (free tier) — email al locale e conferma al cliente (step form).
RESEND_API_KEY=
BOOKING_NOTIFY_EMAIL=

# Indicizzazione motori di ricerca: "true" SOLO quando datina.it punta a questo progetto.
ALLOW_INDEXING=
